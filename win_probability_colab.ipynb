      "source": [
        "## 1. Setup"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "id": "WRaLh2Rd16En",
        "outputId": "35a5d80b-8f79-4e77-89c4-25f212dfab51",
